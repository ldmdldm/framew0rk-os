NODE_ENV=production
PORT=8000

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/agent-framework

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-production-secret-key

# Frontend
FRONTEND_URL=http://localhost

# Blockchain
WEB3_PROVIDER_URL=${WEB3_PROVIDER_URL}
INFURA_API_KEY=${INFURA_API_KEY}
CONTRACT_ADDRESS=${CONTRACT_ADDRESS}

# Gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-pro
LLM_API_KEY=${GEMINI_API_KEY}
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Sentry
SENTRY_DSN=your-sentry-dsn

# Backup
BACKUP_DIR=/backups/mongodb
BACKUP_RETENTION_DAYS=7

VITE_API_URL=https://api.yourdomain.com
VITE_ENVIRONMENT=production
VITE_CONTRACT_ADDRESS=${CONTRACT_ADDRESS}
VITE_WEB3_PROVIDER_URL=${WEB3_PROVIDER_URL}
VITE_INFURA_API_KEY=${INFURA_API_KEY}
VITE_JWT_SECRET=${JWT_SECRET}
VITE_MONGODB_URI=${MONGODB_URI}
VITE_REDIS_URL=${REDIS_URL}
VITE_LLM_PROVIDER=gemini
VITE_LLM_MODEL=gemini-pro
VITE_LLM_API_KEY=${GEMINI_API_KEY}
VITE_LLM_TEMPERATURE=0.7
VITE_LLM_MAX_TOKENS=2000