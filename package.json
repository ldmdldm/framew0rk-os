{
  "name": "framew0rk-os",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test",
    "contract:deploy": "hardhat run scripts/deploy.js",
    "backend:dev": "nodemon backend/src/index.js",
    "backend:start": "node backend/src/index.js",
    "start:prod": "docker-compose up -d",
    "stop:prod": "docker-compose down",
    "deploy": "./scripts/deploy.sh",
    "monitor": "./scripts/monitor.sh",
    "backup": "./backend/scripts/backup.sh",
    "logs": "docker-compose logs -f",
    "clean": "docker-compose down -v",
    "restart": "docker-compose restart",
    "update": "docker-compose pull && docker-compose up -d",
    "health": "curl -s http://localhost:8000/health"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "dotenv": "^16.0.0",
    "ethers": "^5.7.2",
    "express": "^4.18.0",
    "ioredis": "^5.6.1",
    "jwt-decode": "^4.0.0",
    "langchain": "^0.1.0",
    "lucide-react": "^0.344.0",
    "next-auth": "^4.24.0",
    "openai": "^4.0.0",
    "pg": "^8.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-split": "^2.0.0",
    "redis": "^4.6.0",
    "socket.io": "^4.7.0",
    "web3": "^4.0.0",
    "xterm": "^5.0.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.0.0",
    "@typechain/hardhat": "^8.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "hardhat": "^2.19.0",
    "nodemon": "^3.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
