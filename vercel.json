{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist",
        "installCommand": "npm install"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://api.yourdomain.com",
    "VITE_ENVIRONMENT": "production",
    "VITE_CONTRACT_ADDRESS": "0x0000000000000000000000000000000000000000",
    "VITE_WEB3_PROVIDER_URL": "https://mainnet.infura.io/v3/776ec662181b40f18a91f45a4338f95c",
    "VITE_INFURA_API_KEY": "776ec662181b40f18a91f45a4338f95c",
    "VITE_JWT_SECRET": "your-jwt-secret-key",
    "VITE_LLM_PROVIDER": "gemini",
    "VITE_LLM_MODEL": "gemini-pro",
    "VITE_LLM_API_KEY": "@gemini_api_key",
    "VITE_LLM_TEMPERATURE": "0.7",
    "VITE_LLM_MAX_TOKENS": "2000"
  }
} 